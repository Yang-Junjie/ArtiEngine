# 脚本—物理桥接的示例场景（docs/tasks/2026-09-05-script-physics-bridge.md 的第 4 步）。
#
# 和隔壁 script_test.artiscene 的分工：那个的方块是 Kinematic，脚本直接写 transform；这个的
# 玩家是**真的 Dynamic 刚体**，脚本通过 arti.physics.* 推它 —— 会掉、会撞、能被平台托着走。
#
# 两条限制在这个文件里到处可见（Scene.md 3.1）：物理只作用于**没有父级、缩放是 1** 的实体。
# 所以「一大块地面」要拆成缩放过的视觉体 + 不缩放的碰撞体两个实体，而会动的平台只能用单位
# 立方体拼 —— 缩放过的平台物理会跳过，视觉和碰撞就分了家。
Entities:
  - EntityComponents:
      arti.id: 000000000000c001
      arti.parent: ~
      arti.tag: Environment
      arti.transform:
        Translation: [0, 0, 0]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.environment:
        EquirectTexture: 898b72c7c0394447
        SkyColor: [0.03, 0.03, 0.035]
        Intensity: 1
        Enabled: true
        SkyVisible: true
  - EntityComponents:
      arti.id: 000000000000c002
      arti.parent: ~
      arti.tag: Directional Light
      arti.transform:
        Translation: [0, 4, 0]
        Rotation: [0.87542605, -0.4082179, -0.23456971, -0.10938165]
        Scale: [1, 1, 1]
      artiengine.directional_light:
        Color: [1, 1, 1]
        Intensity: 1
        Enabled: true
        CastsShadow: true
        ShadowDistance: 50
  - EntityComponents:
      arti.id: 000000000000c003
      arti.parent: ~
      arti.tag: Main Camera
      arti.transform:
        Translation: [0, 7, 12]
        Rotation: [0.96592583, -0.25881905, 0, 0]
        Scale: [1, 1, 1]
      artiengine.camera:
        FovDegrees: 60
        NearPlane: 0.1
        FarPlane: 100
        Primary: true
  # 地面：缩放过的立方体做视觉，不缩放的空实体做碰撞体。
  - EntityComponents:
      arti.id: 000000000000c004
      arti.parent: ~
      arti.tag: Ground Visual (scaled, physics skips it)
      arti.transform:
        Translation: [0, -0.25, 0]
        Rotation: [1, 0, 0, 0]
        Scale: [24, 0.5, 24]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
  - EntityComponents:
      arti.id: 000000000000c005
      arti.parent: ~
      arti.tag: Ground Body
      arti.transform:
        Translation: [0, -0.25, 0]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.rigid_body:
        Type: Static
        GravityScale: 1
        EnableSleep: true
      artiengine.collider:
        Shape: Box
        HalfExtents: [12, 0.25, 12]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.3
        Restitution: 0
  # 玩家：Dynamic + physics_move.lua（WASD / Shift / Space / R）。
  # **Dynamic 才是这个示例的重点** —— 脚本不写 transform，只设速度和施冲量。
  - EntityComponents:
      arti.id: 000000000000c006
      arti.parent: ~
      arti.tag: Player
      arti.transform:
        Translation: [0, 0.5, 4]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
      artiengine.rigid_body:
        Type: Dynamic
        GravityScale: 1
        EnableSleep: false
      artiengine.collider:
        Shape: Box
        HalfExtents: [0.5, 0.5, 0.5]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.3
        Restitution: 0
      artiengine.script:
        Script: 5c81970000000002
  # 升降平台，三个单位立方体拼出来的。都挂 platform_lift.lua，各自一份 environment、
  # 同一个相位，所以看起来是一整块在动。
  #
  # 为什么不用一个缩放过的长条：物理跳过缩放过的实体，那样平台就只剩视觉、踩不上去。
  - EntityComponents:
      arti.id: 000000000000c007
      arti.parent: ~
      arti.tag: Platform Left
      arti.transform:
        Translation: [-1, 2, -3]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
      artiengine.rigid_body:
        Type: Kinematic
        GravityScale: 1
        EnableSleep: false
      artiengine.collider:
        Shape: Box
        HalfExtents: [0.5, 0.5, 0.5]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.6
        Restitution: 0
      artiengine.script:
        Script: 5c81970000000003
  - EntityComponents:
      arti.id: 000000000000c008
      arti.parent: ~
      arti.tag: Platform Middle
      arti.transform:
        Translation: [0, 2, -3]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
      artiengine.rigid_body:
        Type: Kinematic
        GravityScale: 1
        EnableSleep: false
      artiengine.collider:
        Shape: Box
        HalfExtents: [0.5, 0.5, 0.5]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.6
        Restitution: 0
      artiengine.script:
        Script: 5c81970000000003
  - EntityComponents:
      arti.id: 000000000000c009
      arti.parent: ~
      arti.tag: Platform Right
      arti.transform:
        Translation: [1, 2, -3]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
      artiengine.rigid_body:
        Type: Kinematic
        GravityScale: 1
        EnableSleep: false
      artiengine.collider:
        Shape: Box
        HalfExtents: [0.5, 0.5, 0.5]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.6
        Restitution: 0
      artiengine.script:
        Script: 5c81970000000003
  # 两个能被撞开的箱子：Dynamic 撞 Dynamic，证明玩家不是穿过去的。
  - EntityComponents:
      arti.id: 000000000000c00a
      arti.parent: ~
      arti.tag: Crate A
      arti.transform:
        Translation: [3, 0.5, 0]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
      artiengine.rigid_body:
        Type: Dynamic
        GravityScale: 1
        EnableSleep: true
      artiengine.collider:
        Shape: Box
        HalfExtents: [0.5, 0.5, 0.5]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.3
        Restitution: 0
  - EntityComponents:
      arti.id: 000000000000c00b
      arti.parent: ~
      arti.tag: Crate B
      arti.transform:
        Translation: [-3, 0.5, 1]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000001
        Materials: [b0117e1000000002]
        Visible: true
      artiengine.rigid_body:
        Type: Dynamic
        GravityScale: 1
        EnableSleep: true
      artiengine.collider:
        Shape: Box
        HalfExtents: [0.5, 0.5, 0.5]
        Radius: 0.5
        HalfHeight: 0.5
        Density: 1
        Friction: 0.3
        Restitution: 0
  # 静止的参照物（没有刚体，射线打不中它），这样「东西真的动了」一眼看得出来。
  - EntityComponents:
      arti.id: 000000000000c00c
      arti.parent: ~
      arti.tag: Reference Sphere
      arti.transform:
        Translation: [6, 0.5, -4]
        Rotation: [1, 0, 0, 0]
        Scale: [1, 1, 1]
      artiengine.mesh_renderer:
        Mesh: b0117e1000000003
        Materials: [b0117e1000000002]
        Visible: true
